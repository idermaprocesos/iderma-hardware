<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HardwareRegistro.Pages.EquipmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HardwareRegistro.Models"
    mc:Ignorable="d">

    <Grid Padding="36,8,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="EditorTitle" Style="{ThemeResource TitleLargeTextBlockStyle}" Text="Registrar equipo" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="El código interno identifica el equipo. En componentes se detalla lo que lleva."
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="Cancel_Click" Content="Cancelar" />
                <Button Click="Save_Click" Content="Guardar" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left" Spacing="28">
                <InfoBar
                    x:Name="ValidationBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="Revisa el formulario" />

                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Identificación" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            x:Name="CodeBox"
                            Header="Código interno"
                            PlaceholderText="PC-001"
                            TextChanged="CodeBox_TextChanged" />
                        <ComboBox
                            x:Name="KindBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Header="Tipo de equipo"
                            SelectionChanged="KindBox_SelectionChanged" />
                        <TextBox
                            x:Name="BrandBox"
                            Grid.Row="1"
                            Header="Marca"
                            PlaceholderText="Dell" />
                        <TextBox
                            x:Name="ModelBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Header="Modelo"
                            PlaceholderText="OptiPlex 7090" />
                        <TextBox
                            x:Name="SerialBox"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Header="Número de serie"
                            PlaceholderText="Opcional" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Asignación" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            x:Name="LocationBox"
                            Header="Ubicación"
                            PlaceholderText="Oficina 2, recepción" />
                        <TextBox
                            x:Name="AssigneeBox"
                            Grid.Column="1"
                            Header="Responsable"
                            PlaceholderText="Nombre de quien lo usa" />
                        <ComboBox
                            x:Name="StatusBox"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Header="Estado"
                            IsEditable="True"
                            PlaceholderText="Disponible" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Componentes" />
                        <Button HorizontalAlignment="Right" Click="AddComponent_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Agregar componente" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Puedes renombrar, completar o quitar cada fila. El tipo de equipo solo sugiere una lista inicial."
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Componente" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Especificación" />
                    </Grid>

                    <ItemsControl x:Name="ComponentList" ItemsSource="{x:Bind Components}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ComponentEntry">
                                <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="Nombre"
                                        Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Column="1"
                                        PlaceholderText="{x:Bind Hint, Mode=OneWay}"
                                        Text="{x:Bind Detail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Quitar componente"
                                        Click="RemoveComponent_Click"
                                        ToolTipService.ToolTip="Quitar componente">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBox
                    x:Name="NotesBox"
                    AcceptsReturn="True"
                    Header="Notas"
                    MinHeight="96"
                    PlaceholderText="Observaciones, accesorios entregados, garantía..."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
