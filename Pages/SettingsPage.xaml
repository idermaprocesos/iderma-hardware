<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HardwareRegistro.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="36,8,36,24" MaxWidth="760" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Style="{ThemeResource TitleLargeTextBlockStyle}" Text="Configuración" />
        <TextBlock
            x:Name="CloudText"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="También queda una copia en este equipo."
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="PathText"
            IsTextSelectionEnabled="True"
            TextWrapping="Wrap" />
        <Button HorizontalAlignment="Left" Click="OpenFolder_Click" Content="Abrir carpeta de datos" />
    </StackPanel>
</Page>
